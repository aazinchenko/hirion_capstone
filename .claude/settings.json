{
  "permissions": {
    "allow": [
      "Edit(./src/test/java/ch/hirion/pub/**)",
      "Edit(./src/test/java/ch/hirion/journey/RegistrationTest.java)",
      "Edit(./src/test/java/ch/hirion/journey/DashboardTest.java)",
      "Edit(./src/test/java/ch/hirion/journey/SettingsTest.java)",
      "Edit(./openspec/changes/**)",
      "Edit(./openspec/specs/**)",
      "Bash(pnpm exec openspec:*)",
