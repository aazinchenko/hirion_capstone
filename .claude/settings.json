      "Edit(./openspec/config.yaml)",
      "Edit(./docs/intent.md)",
      "Edit(./AGENTS.md)",
      "Edit(./.claude/settings.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard-live-run.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking for a live account run"
          }
        ]
      }
    ]
